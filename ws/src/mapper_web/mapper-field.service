# Bring the WHOLE field unit up at boot: LiDAR driver + sensors/RTK + dashboard.
#
# Install:
#   sudo cp mapper-field.service /etc/systemd/system/
#   sudo mkdir -p /etc/mapper
#   sudo cp field.env.example /etc/mapper/field.env
#   sudo nano /etc/mapper/field.env      # fill in YOUR workspace path + NTRIP
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mapper-field
#
# Then just power the Pi on - wait ~30 s and open http://<pi-ip>:8080, or use
# the button. Check it with:  systemctl status mapper-field
#
# NTRIP credentials live in /etc/mapper/field.env (root-only, NOT in git), so
# they never end up in the repo.
[Unit]
Description=Livox mapper field unit (LiDAR + RTK + dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/mapper/field.env
# GPIO + shutdown need root.
User=root
# NTRIP_USER / NTRIP_PASS are deliberately NOT passed as launch arguments:
# anything on the command line is world-readable via `ps` and shows up in
# `systemctl status`. field.launch.py reads them from the environment, which
# EnvironmentFile above already provides.
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && \
  source ${MAPPER_WS}/install/setup.bash && \
  ros2 launch mapper_web field.launch.py \
    ntrip_host:=${NTRIP_HOST} ntrip_port:=${NTRIP_PORT} \
    ntrip_mountpoint:=${NTRIP_MOUNT} use_gnss_heading:=true'
Restart=on-failure
RestartSec=5

# Stop the unit the way ros2 launch actually expects to be stopped.
#
# systemd's default stop signal is SIGTERM. `ros2 launch` drives its graceful
# shutdown from SIGINT - that is what makes it tell each node to shut down,
# which is also how the mapping node knows to write its .pcd. Sent SIGTERM
# instead, the tree does not unwind: on 20 Aug 2026 a stop took the full
# 90-second default timeout and ended in
#   mapper-field.service: State 'final-sigterm' timed out. Killing.
#   Killing process 2150 (mapper_web) with signal SIGKILL
#   Killing process 11014 (mapper_web) with signal SIGKILL
# - note TWO dashboards alive at once, which is what a stop that does not
# finish leaves behind. A leftover process still holding /dev/gps is enough to
# stop the next one working: two readers on one serial port each take a share
# of the bytes, so neither sees a whole NMEA sentence and the receiver looks
# silent while being perfectly healthy.
KillSignal=SIGINT
# 30 s is generous for a clean unwind and still leaves a wedged unit recoverable
# in well under a minute, rather than the 90 s default.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
