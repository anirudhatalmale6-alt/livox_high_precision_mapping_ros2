<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mapper_web</name>
  <version>0.1.0</version>
  <description>Web dashboard + GPIO button to run the Livox high-precision mapper
    in the field: start/stop logging to USB, live sensor status, LiDAR config,
    and safe shutdown - all from a phone or laptop, no terminals.</description>
  <maintainer email="mapper@example.com">Mapper</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- LiDAR control link: /livox/lidar_status + /livox/lidar_cmd. -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>livox_hp_mapping_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
