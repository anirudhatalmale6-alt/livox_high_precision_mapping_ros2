# Field unit configuration, read by mapper-field.service at boot.
# Copy to /etc/mapper/field.env and fill in your values. Keep it root-only:
#   sudo chmod 600 /etc/mapper/field.env
# This file holds your NTRIP login, so it is NOT committed to git.

# Your colcon workspace (the repo's ws folder).
MAPPER_WS=/home/drone1/livox_high_precision_mapping_ros2/ws

# NTRIP caster for RTK corrections.
NTRIP_HOST=your.ntrip.host
NTRIP_PORT=2101
NTRIP_MOUNT=YOUR_MOUNTPOINT
NTRIP_USER=your_username
NTRIP_PASS=your_password

# Pushbutton and RGB status LED pins.
#
# A plain number is a Raspberry Pi BCM pin (the default 26/16/20/21).
# CHIP:LINE addresses a kernel GPIO line instead and works on ANY board -
# needed on an Orange Pi, where BCM numbers do not exist.
#
# Allwinner headers are labelled PB3 / PD4 / PL5. Convert a name with:
#   bash scripts/list_gpio.sh names PD4
# or find the line empirically by pressing the button:
#   bash scripts/list_gpio.sh watch
#
# Example - Orange Pi Zero 3W, button on PD4, LED on PD2/PB8/PB7:
#   BUTTON_GPIO=0:100
#   LED_RED=0:98
#   LED_GREEN=0:40
#   LED_BLUE=0:39
BUTTON_GPIO=26
LED_RED=16
LED_GREEN=20
LED_BLUE=21
